// Import core components
import { isEqual } from 'lodash'
import Promise from 'bluebird'

// Import our components
import * as Utils from 'toolkits/utils'
import IDB from './_idb'

class IDBEmitter extends IDB {
  #emitter = new EventTarget()

  #cache

  #effects = {}

  #listeners = {}

  #predicates = {}

  remove(keys) {
    console.time('remove')

    return super
      .remove(keys)
      .then((results) =>
        Promise.reduce(
          results,
          (paths, result) => {
            const [store, ...parts] = result.split('.')

            parts.reduce((path, part) => {
              const branch = [path, part].join('.')

              if (this.#listeners[branch]) paths.add(branch)
              return branch
            }, store)

            return paths
          },
          new Set()
        )
      )
      .then((paths) =>
        Promise.map([...paths], (path) => super.range(path).then((result) => this.#emitter.dispatchEvent(new CustomEvent(path, { detail: result }))))
      )
      .then(() => console.timeEnd('remove'))
      .catch((err) => console.error(err))
  }

  swap(keys) {
    console.time('swap')

    return super
      .swap(keys)
      .then((results) =>
        Promise.reduce(
          results,
          (paths, entries) => {
            entries.forEach((entry) => {
              const [store, ...parts] = entry.split('.')

              parts.reduce((path, part) => {
                const branch = [path, part].join('.')

                if (this.#listeners[branch]) paths.add(branch)
                return branch
              }, store)
            })

            return paths
          },
          new Set()
        )
      )
      .then((paths) =>
        Promise.map([...paths], (path) => super.range(path).then((result) => this.#emitter.dispatchEvent(new CustomEvent(path, { detail: result }))))
      )
      .then(() => console.timeEnd('swap'))
      .catch((err) => console.error(err))
  }

  update(data) {
    // const now = Date.now()
    // console.time(`write${now}`)

    return (
      super
        .update(data)
        .then((results) =>
          Promise.reduce(
            results,
            (paths, result) => {
              if (!result.updated) return paths

              const [store, ...parts] = result.key.split('.')

              Utils.setObjValue(this.#cache, result.key, result.value)

              parts.reduce((path, part) => {
                const branch = [path, part].join('.')

                if (this.#listeners[branch]) paths.add(branch)
                return branch
              }, store)

              return paths
            },
            new Set()
          )
        )
        .then((paths) =>
          Promise.map([...paths], (path) => this.#emitter.dispatchEvent(new CustomEvent(path, { detail: Utils.getObjValue(this.#cache, path) })))
        )
        // // .then(() => console.timeEnd(`write${now}`))
        .catch((err) => console.error(err))
    )
  }

  // eslint-disable-next-line class-methods-use-this
  addEventListener(event, id, fn) {
    if (!this.#effects[event]) this.#effects[event] = {}
    if (!this.#listeners[event]) this.#listeners[event] = {}
    if (!this.#predicates[event]) this.#predicates[event] = {}

    if (!Object.keys(this.#listeners[event]).length) {
      const predicate = (_, state, prevState) => {
        const val = Utils.getObjValue(state.idb, event)
        const prevVal = Utils.getObjValue(prevState.idb, event)

        return !isEqual(val, prevVal)
      }
      const effect = (_, api) => {
        const state = api.getState()
        const val = Utils.getObjValue(state.idb, event)

        console.log(event, val)

        // this.#emitter.dispatchEvent(new CustomEvent(event, { detail: val }))
        Object.values(this.#listeners[event]).forEach((cb) => cb(val))
      }

      this.#predicates[event][id] = predicate
      this.#effects[event][id] = effect
    }

    this.#listeners[event][id] = fn.bind(null, null, event)
    // this.#emitter.addEventListener(event, this.#listeners[event][id])
  }

  // eslint-disable-next-line class-methods-use-this
  removeEventListener(event, id) {
    // const fn = this.#listeners[event][id]
    // this.#emitter.removeEventListener(event, fn)

    delete this.#effects[event][id]
    delete this.#listeners[event][id]
    delete this.#predicates[event][id]
  }
}

export default IDBEmitter
