{
  "name": "@single-studio/core",
  "version": "0.1.2",
  "description": "Local-first broadcast graphics framework for OBS: replicated state, source graphics, and control surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FourCourtJester/Single-Studio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/FourCourtJester/Single-Studio#readme",
  "bugs": "https://github.com/FourCourtJester/Single-Studio/issues",
  "keywords": [
    "obs",
    "broadcast",
    "graphics",
    "overlay",
    "streaming",
    "local-first",
    "crdt",
    "yjs",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./styles.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=6.22"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
