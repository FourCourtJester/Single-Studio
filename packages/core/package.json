{
  "name": "@single-studio/core",
  "version": "0.4.0",
  "description": "Local-first broadcast graphics framework for OBS: replicated state, source graphics, and control surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FourCourtJester/Single-Studio.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/FourCourtJester/Single-Studio#readme",
  "bugs": "https://github.com/FourCourtJester/Single-Studio/issues",
  "keywords": [
    "obs",
    "broadcast",
    "graphics",
    "overlay",
    "streaming",
    "local-first",
    "crdt",
    "yjs",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "css-vars.d.ts",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./control": {
      "types": "./dist/types/control.d.ts",
      "import": "./dist/control.js",
      "default": "./dist/control.js"
    },
    "./source": {
      "types": "./dist/types/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    },
    "./worker": {
      "types": "./dist/types/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./styles.css": "./src/styles/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "vite build && tsc -p tsconfig.json && node ../../scripts/ship-css-vars.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": ">=7.18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
