{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.js",
    "src/**/*.jsx"
  ]
}
