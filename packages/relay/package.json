    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run"
  },
  "dependencies": {
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "vitest": "^3.2.6",
    "ws": "^8.21.3",
    "y-websocket": "^3.1.0"
  }
