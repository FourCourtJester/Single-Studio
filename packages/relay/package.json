{
  "name": "@single-studio/relay",
  "version": "0.1.0",
  "private": true,
  "description": "Collaboration relay for Single Studio: one room per show, holding the document and rebroadcasting updates.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/room.js",
    "./node": "./src/node.js",
    "./worker": "./src/worker.js"
  },
  "bin": {
    "single-studio-relay": "./bin/relay.mjs"
  },
  "scripts": {
