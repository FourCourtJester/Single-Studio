{
  "name": "single-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Single Studio: a local-first broadcast graphics framework for OBS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "demo": "pnpm build && pnpm --filter @single-studio/demo dev",
    "demo:build": "pnpm build && pnpm --filter @single-studio/demo build",
    "demo:preview": "pnpm --filter @single-studio/demo preview",
    "core:watch": "pnpm --filter @single-studio/core dev",
    "e2e": "pnpm --filter @single-studio/demo e2e",
    "e2e:browser": "pnpm --filter @single-studio/demo exec playwright install chromium",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,yaml,yml}\"",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @single-studio/core test:watch",
    "relay": "node packages/relay/bin/relay.mjs",
    "e2e:relay": "pnpm --filter @single-studio/demo e2e:relay"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.1"
  }
}
