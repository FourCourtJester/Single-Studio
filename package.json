{
  "name": "single-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Single Studio: a local-first broadcast graphics framework for OBS.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "fixture": "pnpm build && pnpm --filter @single-studio/fixture dev",
    "fixture:build": "pnpm build && pnpm --filter @single-studio/fixture build",
    "fixture:preview": "pnpm --filter @single-studio/fixture preview",
    "core:watch": "pnpm --filter @single-studio/core dev",
    "e2e": "pnpm --filter @single-studio/fixture e2e",
    "e2e:browser": "pnpm --filter @single-studio/fixture exec playwright install chromium",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @single-studio/core build && node node_modules/typescript/bin/tsc -p apps/fixture/tsconfig.json",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md,yaml,yml}\"",
    "test": "pnpm -r test",
    "verify:template": "node scripts/verify-template.mjs",
    "api:reference": "node scripts/api-reference.mjs",
    "test:watch": "pnpm --filter @single-studio/core test:watch",
    "relay": "node packages/relay/bin/relay.mjs",
    "e2e:relay": "pnpm --filter @single-studio/fixture e2e:relay",
    "docs": "vitepress dev docs",
    "docs:build": "pnpm api:reference && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.1",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    }
  }
}
